# Copy to .env and fill in real values. Do NOT commit .env.

ANTHROPIC_API_KEY=sk-ant-...
ELEVENLABS_API_KEY=...
# The voice ID is the 20-char string from the Voice Library URL:
# https://elevenlabs.io/app/voice-library?voiceId=ErXwobaYiN019PkySvjV
#                                                ^^^^^^^^^^^^^^^^^^^^^
# NOT the display name. NOT the voice description.
ELEVENLABS_VOICE_ID=ErXwobaYiN019PkySvjV
PEXELS_API_KEY=...

# Optional overrides
OUTPUT_DIR=output
CACHE_DIR=cache
ASSETS_DIR=assets
BACKGROUND_MUSIC=assets/music/bg.mp3
